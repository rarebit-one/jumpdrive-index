# /etc/starchart/starchart.env — Starchart configuration (all config is JDX_* env).
# Install as 0640 root:starchart. See docs/deploy/reference-linux-host.md.

JDX_BACKEND=sqlite
JDX_DSN=/var/lib/starchart/starchart.db
JDX_IDENTITY=starchart
JDX_PRINCIPALS_FILE=/etc/starchart/principals.json

# Loopback + auth by default. Serving unauthenticated on a routable address is a
# HARD startup refusal (ADR-0011) — put Starchart behind Tailscale / a reverse
# proxy and keep JDX_AUTH=true if you bind a non-loopback address.
JDX_HTTP_ADDR=127.0.0.1:8090
JDX_AUTH=true
