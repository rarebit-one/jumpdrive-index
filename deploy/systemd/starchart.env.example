# /etc/starchart/starchart.env — Starchart configuration (all config is JDX_* env).
# Install as 0640 root:starchart. See docs/deploy/reference-linux-host.md.

JDX_BACKEND=sqlite
JDX_DSN=/var/lib/starchart/starchart.db
JDX_IDENTITY=starchart
JDX_PRINCIPALS_FILE=/etc/starchart/principals.json

# Loopback + auth by default. Serving unauthenticated on a routable address is a
# HARD startup refusal (heyarr ADR-0011) — put Starchart behind Tailscale / a reverse
# proxy and keep JDX_AUTH=true if you bind a non-loopback address.
JDX_HTTP_ADDR=127.0.0.1:8090
JDX_AUTH=true

# Optional: require a Void-Which-Binds Device credential on /mcp instead of shared
# bearers (see "Device-credential callers" in docs/deploy/reference-linux-host.md).
# The membership dir must be persistent + writable; startup fails if it is not.
#JDX_MCP_AUTH_MODE=voidbind
#JDX_MCP_VOIDBIND_TRUST_FILE=/etc/starchart/pinned-users
#JDX_MCP_VOIDBIND_MEMBERSHIP_DIR=/var/lib/starchart/voidbind-membership

# Optional: local embedder. JDX_EMBED_PROVIDER selects the backend:
#   none (default) — embeddings are skipped
#   ollama          — a local Ollama instance
#   fabric          — Farcaster (OpenAI-compat) with Voidbind or bearer auth
#JDX_EMBED_PROVIDER=none
#JDX_EMBED_URL=http://localhost:11434
#JDX_EMBED_MODEL=nomic-embed-text

# fabric embedder — optional bearer; omit when JDX_FABRIC_DEVICE_DIR is set
#JDX_EMBED_TOKEN=<bearer>

# Optional: out-of-process transcriber for `jumpdrive-index ingest`.
#   local/whisper (default) — yt-dlp + local Whisper subprocess
#   fabric                  — Farcaster /v1/audio/transcriptions endpoint
#JDX_INGEST_TRANSCRIBE=local
#JDX_INGEST_TRANSCRIBE_URL=https://farcaster.example.com
#JDX_INGEST_TRANSCRIBE_MODEL=whisper-1
#JDX_INGEST_TRANSCRIBE_TOKEN=<bearer>

# Fabric device store — shared by embed (fabric) and ingest (fabric) providers.
# When set, a per-request Voidbind Device credential is used instead of a bearer.
#JDX_FABRIC_DEVICE_DIR=/var/lib/starchart/fabric-devices
